# /etc/magicmirror/edge-bridge.env -- environment for systemd/edge-bridge.service
# Copy, fill in, keep it out of the repo (mode 640, root:tobiask).

# Broker of pi-edge-ai on this Pi. 1884 is the authenticated listener;
# the ACL there lets the user "mirror" read edge/# and nothing else.
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_USERNAME=mirror
MQTT_PASSWORD=CHANGEME

# Which gesture does what. Actions: show, hide (scripts/guest-page.sh).
GESTURE_ACTIONS=swipe_up=show,swipe_down=hide

# Drop gestures older than this many seconds (QoS 1 redelivery).
BRIDGE_MAX_AGE=5

# Minimum seconds between two identical actions.
BRIDGE_MIN_GAP=2

# Empty: accept every source, including synthetic test gestures from
# `make gesture-sim` in pi-edge-ai. Set to sen0628 once the sensor runs.
BRIDGE_SOURCES=
