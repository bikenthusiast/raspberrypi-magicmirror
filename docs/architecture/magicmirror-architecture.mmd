  classDef own  fill:#F5E9E5,stroke:#C39284,color:#6B3A2E
  classDef hw   fill:#EFEBF4,stroke:#9D92B5,color:#433A5C
  classDef ext  fill:#EEF1E6,stroke:#9DA883,color:#45502E

  class MAC,GH dev
  class UNIT,WL,MM sw
  class CAL,OWM,RAIN,MVG,GLOBE,SPOT,LYR,PAGES com
  class SP,GW own
  class WP,RAD,MON,GLASS hw
  class SAPI,OAPI,LAPI ext
  style PI fill:#EEF4F1,stroke:#86AA9F,color:#2E5048
