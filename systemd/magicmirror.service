# MagicMirror server mode, started on boot.
#
# Install:
#   sudo cp systemd/magicmirror.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now magicmirror
#
# Watch:
#   journalctl -u magicmirror -f
#
# Adjust User and paths if your setup differs.

[Unit]
Description=MagicMirror (server mode)

# Wait for a usable network. network.target alone only means the
# networking stack was started -- not that an address has been
# assigned. Several modules fetch data on startup and fail silently
# if DNS is not resolvable yet, which is what caused the calendar to
# hang after a reboot.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tobiask
WorkingDirectory=/home/tobiask/Projects/MagicMirror

# npm sits under the user's PATH, which systemd does not inherit.
# Calling node directly avoids depending on it.
ExecStart=/usr/bin/node --run server

# Restart on crash, but not when stopped on purpose. "on-failure"
# excludes a clean exit, so `systemctl stop` does not fight back.
Restart=on-failure
RestartSec=10

# Give up after 5 restarts within 5 minutes. Without this a module
# that crashes on load produces an endless restart loop that fills
# the journal and hides the actual error.
StartLimitBurst=5
StartLimitIntervalSec=300

# Node writes to stdout; the journal picks it up. Retrieve with
# journalctl -u magicmirror.
StandardOutput=journal
StandardError=journal

# --- Hardening -----------------------------------------------------
# Each of these narrows what the process can reach. If something
# breaks, these are the first lines to comment out.

# No setuid escalation from this process or its children.
NoNewPrivileges=true

# Private /tmp, invisible to other services.
PrivateTmp=true

# Whole filesystem read-only except the paths listed below.
ProtectSystem=strict

# Home directories read-only by default...
ProtectHome=read-only

# ...with these exceptions. config/ because config.js is generated
# there; modules/ because some modules cache data; logs/ for the
# log files.
ReadWritePaths=/home/tobiask/Projects/MagicMirror/config
ReadWritePaths=/home/tobiask/Projects/MagicMirror/modules
ReadWritePaths=/home/tobiask/Projects/MagicMirror/logs

[Install]
# Start at the normal multi-user boot stage. Not graphical.target,
# since server mode needs no display.
WantedBy=multi-user.target
