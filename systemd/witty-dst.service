# Keeps the Witty Pi schedule on local time across DST changes -- see
# scripts/witty-dst.sh and docs/hardware.md. Started by witty-dst.timer.
#
# Install (system units, like presence.service):
#   sudo cp systemd/witty-dst.service systemd/witty-dst.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now witty-dst.timer
#
# Logs:
#   journalctl -t witty-dst

[Unit]
Description=Re-anchor the Witty Pi schedule after a DST change
After=time-sync.target

[Service]
Type=oneshot
ExecStart=/home/tobiask/Projects/raspberrypi-magicmirror/scripts/witty-dst.sh
SyslogIdentifier=witty-dst
