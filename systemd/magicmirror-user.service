# MagicMirror under Electron, as a systemd user service.
#
# Install (see docs/setup.md, section 13):
#   cp systemd/magicmirror-user.service ~/.config/systemd/user/magicmirror.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now magicmirror
#   sudo loginctl enable-linger "$USER"
#
# Logs go to the journal:
#   journalctl -t magicmirror -b

[Unit]
Description=MagicMirror (Electron)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# %h expands to the home directory of the user running the service.
WorkingDirectory=%h/Projects/MagicMirror
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=15

# Journal instead of an append: file. A single file accumulates every run with
# no marker between restarts, which once led to chasing errors that had long
# been fixed. See docs/logging.md.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magicmirror

[Install]
WantedBy=default.target
