# Presence detection: switches the mirror panel via HDMI-CEC.
#
# Install:
#   sudo cp systemd/presence.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now presence
#
# Watch:
#   journalctl -u presence -f

[Unit]
Description=Presence detection for MagicMirror

# No dependency on magicmirror.service any more: switching goes
# straight to the monitor over CEC, so presence detection works even
# when the mirror itself is down.
After=network-online.target
Wants=network-online.target

StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=tobiask

# lgpio writes a notification file to the working directory.
WorkingDirectory=/home/tobiask

ExecStart=/usr/bin/python3 /home/tobiask/Projects/raspberrypi-magicmirror/scripts/presence.py

Restart=on-failure

# 30 s rather than 10: a dying process needs time to release
# /dev/gpiochip0, and a restart arriving too early cannot claim it.
RestartSec=30

# gpiozero otherwise falls back to the "native" pin factory, which
# uses the sysfs GPIO interface removed in recent kernels.
Environment=GPIOZERO_PIN_FACTORY=lgpio

Environment=PRESENCE_GPIO=27
Environment=PRESENCE_GRACE=120
Environment=PRESENCE_BOUNCE=0.5
Environment=PRESENCE_MIN_GAP=5

# One CEC device per HDMI port: HDMI0 (inner, next to USB-C) is
# HDMI-A-1 and /dev/cec0, HDMI1 (outer) is HDMI-A-2 and /dev/cec1.
# Confirm with `cec-ctl -d /dev/cecN` -- it prints the adapter name and
# the DRM connector. A device without a display reports the physical
# address f.f.f.f and swallows every command silently.
Environment=CEC_DEVICE=/dev/cec0
Environment=CEC_TARGET=0

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target